# Mizaan — environment variables (names only; never commit real values).
# Everything is optional. With no data keys the site renders honest empty states;
# set DEMO_MODE=1 locally to see it populated with sample data.
# See DEPLOY.md for where each one goes (Vercel vs GitHub Actions).

# --- Demo mode ---
DEMO_MODE=                       # "1" = serve the committed sample data (local dev, tests, CI builds).
                                 # NEVER set in production: with it unset, every figure is real or absent.

# --- Site ---
NEXT_PUBLIC_SITE_URL=            # https://www.mizaan.tech (canonical host)

# --- Market data providers (server-only; free tiers) ---
FINNHUB_API_KEY=                 # primary live quotes (60/min)
FRED_API_KEY=                    # US macro series
FMP_API_KEY=                     # fundamentals + quote/profile fallback
POLYGON_API_KEY=                 # candles / EOD quotes
EODHD_API_KEY=                   # EOD candle backfill
ALPHAVANTAGE_API_KEY=            # last-resort fallback
PEXELS_API_KEY=                  # cover photos (jobs only, cached)
GROQ_API_KEY=                    # AI story summaries (jobs only)
GROQ_MODEL=                      # optional Groq model override
SEC_USER_AGENT=                  # e.g. "Mizaan you@mizaan.com" (SEC EDGAR)

# --- Storage / cache ---
POSTGRES_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=          # alternative to KV_REST_API_*
UPSTASH_REDIS_REST_TOKEN=
EMBEDDER=                        # "minilm" in the Actions runner

# --- Jobs / cron ---
CRON_SECRET=                     # bearer token for /api/cron/* (also a GitHub secret)
APP_URL=                         # GitHub Actions: the production URL the jobs call

# --- Newsletter (Mizaan Morning) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=              # "Mizaan Subscribers" audience
NEWSLETTER_FROM=                 # "Mizaan Morning <briefing@mizaan.tech>"
NEWSLETTER_SECRET=               # HMAC secret for opt-in/unsubscribe tokens
NEWSLETTER_ENABLED=              # "0" to disable signups + sends
NEWSLETTER_DRYRUN=               # "1" sends the briefing only to the editor

# --- Contact form ---
CONTACT_INBOX=                   # where enquiries are delivered
CONTACT_FROM=                    # a verified Resend sender

# --- SEO / security toggles ---
INDEXNOW_KEY=                    # enables IndexNow pings
BLOCK_AI_CRAWLERS=               # "1" disallows GPTBot/CCBot/ClaudeBot in robots.txt

# --- Analytics (Phase 7; public IDs) ---
NEXT_PUBLIC_GA_ID=               # G-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=
GSC_VERIFICATION=                # Search Console meta verification code
