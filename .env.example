# MarketIntelligence 2.0 — environment (§15)
# The app renders useful content with ZERO keys configured (fixture mode).
# Every key below is optional in dev; missing keys degrade gracefully.
#
# NON-NEGOTIABLE (§2, §17): there is NO AI provider key in V1.
# Do not add ANTHROPIC_API_KEY, OPENAI_API_KEY, or any hosted-model key.

# --- Market data providers (all free tier) ---
FINNHUB_API_KEY=            # free tier — primary equity quotes/profiles/news
TWELVEDATA_API_KEY=         # free tier — secondary quotes, FX, multi-asset
FRED_API_KEY=               # free — US macro series
ALPHAVANTAGE_API_KEY=       # optional last-resort fallback, free

# --- Storage (Vercel) ---
POSTGRES_URL=               # Vercel Postgres (Neon) + pgvector
KV_REST_API_URL=            # Vercel KV
KV_REST_API_TOKEN=

# --- Jobs / scheduling ---
# Shared secret. Also set as a GitHub Actions secret. Every /api/cron/* route
# verifies `Authorization: Bearer ${CRON_SECRET}` and returns 401 otherwise.
CRON_SECRET=

# --- Required by SEC EDGAR: a descriptive User-Agent ---
SEC_USER_AGENT=             # e.g. "MarketIntelligence contact@yourdomain.com"

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
